# ============================================================
# Blogger Automation Bot - Environment Variables
# ============================================================
# Copy this file and rename it to ".env"
# Then fill in your actual values below.
# NEVER share your .env file or commit it to GitHub!
# ============================================================

# --- Google Gemini AI API Key ---
# Get yours from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- AI Provider Mode ---
# auto = Gemini first, then OpenRouter/OpenAI if a provider fails
# gemini = Gemini only
# openrouter = OpenRouter only
AI_PROVIDER=auto

# --- OpenRouter fallback ---
# Generate a key from: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_new_key_here
OPENROUTER_MODEL=inclusionai/ling-2.6-flash:free
OPENROUTER_MODELS=inclusionai/ling-2.6-flash:free,liquid/lfm-2.5-1.2b-instruct:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_SECONDS=40
OPENROUTER_APP_NAME=Blogger Automation Bot

# --- AI speed guardrails ---
AI_TOTAL_TIME_BUDGET_SECONDS=180
GEMINI_TIMEOUT_SECONDS=45
AI_MODEL_TIMEOUT_SECONDS=40

# --- Blogger Blog ID ---
# Find it in your Blogger dashboard URL:
# https://www.blogger.com/blog/posts/YOUR_BLOG_ID
BLOG_ID=your_blog_id_here

# --- Blogger OAuth Credentials ---
# Client ID and Client Secret from Google Cloud OAuth desktop app
BLOGGER_CLIENT_ID=your_blogger_client_id_here
BLOGGER_CLIENT_SECRET=your_blogger_client_secret_here

# --- Source Website URL to Scrape ---
SOURCE_URL=https://darkwebinformer.com/tag/tools/

# --- Optional: Multiple article sources (comma-separated) ---
# If set, these sources are used instead of SOURCE_URL.
SOURCES=https://darkwebinformer.com,https://www.bleepingcomputer.com,https://thehackernews.com

# --- Optional: How many seconds to wait between checks (default: 3600 = 1 hour) ---
CHECK_INTERVAL=3600

# --- Optional: How many seconds to wait between API retries (default: 30) ---
RETRY_DELAY=30

# --- Optional: Max retries before giving up (default: 3) ---
MAX_RETRIES=3

# --- Optional: Local fallback when Blogger OAuth is unavailable ---
LOCAL_PUBLISH_FALLBACK=false

# --- Optional: Blogger publishing mode ---
# draft is the safe default. Live publishing only happens when set exactly to live.
PUBLISH_MODE=live
SAFE_MODE=false
BLOGGER_LIVE_ENABLED=true
FAST_NEWS_MODE=true
CATEGORY_ROTATION_MODE=true
PROCESS_FULL_CATEGORY_PER_RUN=true
FRESH_QUEUE_MODE=false
FIRST_VALID_ARTICLE_MODE=true
RECENT_NEWS_ONLY=true
RECENT_ONLY=true
RECENT_NEWS_MAX_AGE_HOURS=2
RECENT_HOURS=2
FRESHNESS_SAFETY_MARGIN_MINUTES=10
FALLBACK_FIRST_RUN_LOOKBACK_HOURS=6
CRAWL_INTERVAL_MINUTES=5
CRAWL_OVERLAP_MINUTES=10
ALLOW_UNKNOWN_DATE_IN_FAST_MODE=false
MAX_POSTS_PER_RUN=1
MAX_ARTICLES_PER_RUN=1
PUBLISH_WEAK_ARTICLES=true
ALLOW_SHORT_ARTICLES=true
MIN_ARTICLE_WORDS=80
TARGET_ARTICLE_WORDS=700-1000
MIN_EXTRACTED_CHARS=80
MAX_SOURCE_RETRIES=1
SOURCE_RETRY_DELAY_SECONDS=2
SOURCE_TIMEOUT_SECONDS=12
ARTICLE_TIMEOUT_SECONDS=15
AI_TIMEOUT_SECONDS=180
MAX_AI_RETRIES=3
MAX_SOURCES_PER_RUN=4
DUPLICATE_PROTECTION=true
QUEUE_PERSIST=true
SOURCE_HEALTH_ENABLED=true
SKIP_ADS_AFFILIATE_SPONSORED=true
SOURCE_FAILURE_COOLDOWN_MINUTES=45
SOURCE_FAILURE_THRESHOLD=3

# --- Optional: Facebook Page auto-posting ---
# Disabled by default. Runs only after a successful live Blogger publish.
FACEBOOK_AUTO_POST=true
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_LINK_MODE=comment
MAX_FACEBOOK_POSTS_PER_DAY=20
MIN_MINUTES_BETWEEN_FACEBOOK_POSTS=0
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VaDv5d05vKADlup5761h
JOBS_MODE=false

# --- Optional: Telegram auto-cycle alerts ---
# Disabled by default. Requires a Telegram bot token and chat ID.
TELEGRAM_ENABLED=true
TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: Quality-first backlog publishing ---
# The bot collects a larger pool, saves every usable article, then can publish up to 12/hour
# when fresh dated articles exist and the 5-minute scheduler keeps finding eligible items.
# Thin articles are not forgotten; they are deferred or rewritten with stronger editorial notes.
ARTICLE_SELECTION_MULTIPLIER=4
ARTICLE_SELECTION_POOL_MIN=20
MIN_ARTICLE_BODY_CHARS=80
MAX_ARTICLES_PER_SOURCE_PER_RUN=2

# --- Optional: Phase 9 safe-cycle guardrails ---
# safe-cycle always creates/updates Blogger drafts only and processes one article.
SAFE_CYCLE_MAX_ARTICLES=1
CATEGORY_POSTS_PER_HOUR=1
HOURLY_POST_LIMIT=1
SAFE_CYCLE_DRAFT_ONLY=false

# --- Optional: Phase 10 safe-cycle scheduling controls ---
MAX_DRAFTS_PER_DAY=10
MIN_MINUTES_BETWEEN_DRAFTS=30
MAX_LIVE_POSTS_PER_DAY=20
TARGET_LIVE_POSTS_PER_DAY=12
MIN_MINUTES_BETWEEN_LIVE_POSTS=0

# --- Optional pacing between requests/actions in seconds ---
SCRAPE_DELAY_SECONDS=2
TRANSLATION_DELAY_SECONDS=3
PUBLISH_DELAY_SECONDS=5


# --- Jobs v2 (quality-first test pipeline) ---
JOBS_TEST_BLOG_URL=https://cyberopluss.blogspot.com/
JOBS_EXPECTED_BLOG_HOST=cyberopluss.blogspot.com
JOBS_DAILY_PUBLISH_LIMIT=1
JOBS_MIN_SELECTION_SCORE=75
JOBS_URGENT_EXTRA_DAILY_LIMIT=1
JOBS_TIMEZONE=Africa/Casablanca
JOBS_LIVE_PUBLISH=false
JOBS_LIVE_FACEBOOK=false
JOBS_GOOGLE_INDEXING_ENABLED=false
# GOOGLE_SERVICE_ACCOUNT_JSON=  # enable only on the final indexed site
