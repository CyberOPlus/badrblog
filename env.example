# ============================================================
# Cybero Plus Jobs Automation - Environment Variables
# ============================================================
# Copy to .env only for local development. GitHub production uses Secrets
# plus the Jobs-only values written by .github/workflows/auto-cycle.yml.
# Never commit real secrets.
# ============================================================

# --- AI providers ---
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=20

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODELS=openrouter/free
OPENROUTER_MAX_TOKENS=8192
OPENROUTER_TIMEOUT_SECONDS=20
OPENROUTER_APP_NAME=Jobs Automation

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=20

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TIMEOUT_SECONDS=20

AI_TOTAL_TIME_BUDGET_SECONDS=75
AI_MODEL_TIMEOUT_SECONDS=20
MAX_AI_RETRIES=2
JOBS_AI_QUALITY_REPAIRS=1
JOBS_AI_TIMEOUT_RETRIES=0
JOBS_AI_CROSS_CANDIDATE_RETRIES=1

# --- Blogger ---
BLOG_ID=
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
PUBLISH_MODE=live
SAFE_MODE=false
BLOGGER_LIVE_ENABLED=true
MAX_POSTS_PER_RUN=1
MAX_ARTICLES_PER_RUN=1
SAFE_CYCLE_MAX_ARTICLES=1
SAFE_CYCLE_DRAFT_ONLY=false

# --- Jobs-only policy ---
JOBS_MODE=true
JOBS_TIMEZONE=Africa/Casablanca
JOBS_EXPECTED_BLOG_HOST=example.invalid
JOBS_MIN_SELECTION_SCORE=65
JOBS_QUEUE_SCORE=50
JOBS_MAX_PUBLISH_AGE_HOURS=12
JOBS_URGENT_EXTRA_DAILY_LIMIT=1
JOBS_ADAPTIVE_PUBLISHING=true
JOBS_ADAPTIVE_MIN_DAILY_CAP=240
JOBS_ADAPTIVE_MAX_DAILY_CAP=240
JOBS_ACTIVE_START_HOUR=0
JOBS_ACTIVE_END_HOUR=24
JOBS_MIN_PUBLISH_INTERVAL_MINUTES=5
JOBS_ENRICH_MAX_TARGETS_PER_CYCLE=12

# Discovery reads official vacancy sources from sources.json.
# The durable ID memory and resume cursor prevent re-scanning old listings.
MAX_SOURCES_PER_RUN=20
JOBS_DISCOVERY_PAGE_SIZE=20
JOBS_DISCOVERY_MAX_PAGES=12
JOBS_DISCOVERY_SEEN_STREAK=8
JOBS_DISCOVERY_MAX_ITEMS_PER_SOURCE=250
JOBS_DISCOVERY_SEEN_MEMORY=5000
CRAWL_OVERLAP_MINUTES=10
SOURCE_TIMEOUT_SECONDS=6
ARTICLE_TIMEOUT_SECONDS=8
MAX_SOURCE_RETRIES=0
SOURCE_RETRY_DELAY_SECONDS=0
SOURCE_HEALTH_ENABLED=true
ENABLE_SCRAPLING_FALLBACK=false

# --- Article quality ---
MIN_ARTICLE_WORDS=120
MIN_EXTRACTED_CHARS=80
DUPLICATE_PROTECTION=true
QUEUE_PERSIST=true
SKIP_ADS_AFFILIATE_SPONSORED=true

# --- Facebook Jobs promotion ---
FACEBOOK_AUTO_POST=true
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v26.0
JOBS_FACEBOOK_FOLLOW_ARTICLE=true
JOBS_FACEBOOK_MAX_POSTS_PER_DAY=240
JOBS_FACEBOOK_MIN_INTERVAL_MINUTES=5
WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029Vb7MdMfBVJl1kmmV4T0e

# --- Optional Google indexing ---
JOBS_GOOGLE_INDEXING_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Scheduler/local loop ---
CHECK_INTERVAL=3600
RETRY_DELAY=30
